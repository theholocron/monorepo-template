  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "^2.0.1",
    "@theholocron/eslint-config": "catalog:configs",
